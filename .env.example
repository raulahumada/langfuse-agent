# --- Langfuse (lo lee el MCP propio) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-demo
LANGFUSE_SECRET_KEY=sk-lf-local-demo

# --- Agente (OpenAI) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Precios del modelo en USD por millón de tokens (ver la página de precios de OpenAI para OPENAI_MODEL).
# Sin ellos el panel de consumo muestra solo tokens.
OPENAI_PRICE_IN_PER_M=0.15   # gpt-4o-mini
OPENAI_PRICE_OUT_PER_M=0.60  # gpt-4o-mini

# --- MCP de GitHub ---
# Token fine-grained sobre el repo del producto, con permisos:
#   Contents: Read and write | Pull requests: Read and write | Metadata: Read-only
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_...
GITHUB_REPO=owner/repo

# --- Opcional ---
# WEB_ORIGIN=http://localhost:3001          # CORS de la API (coma-separado)
# NEXT_PUBLIC_API_URL=http://localhost:8000  # URL de la API para el front (web/.env.local)
